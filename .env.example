# Keep the real key out of source control. The UI never receives it.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
DATABASE_URL=sqlite:///data/impact.db
NVIDIA_RPM=6
NVIDIA_TPM=24000
NVIDIA_DAILY_CALLS=100
NVIDIA_MAX_OUTPUT_TOKENS=2500
NVIDIA_MAX_INPUT_CHARS=24000
# Optional API authentication for deployments. Put the same token in the UI connection dialog.
IMPACT_API_TOKEN=
# Semicolon-separated, administrator-controlled repository roots. Default: examples/.
REPOSITORY_ROOTS=
POSTGRES_PASSWORD=
